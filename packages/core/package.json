{
  "name": "@tuicraft/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure core for the tuicraft TUI component studio: themes, JSX → ANSI renderer, color math, ambient .d.ts generator, workspace state model and URL-hash codec.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "api-report",
    "docs",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && api-extractor run --local",
    "build:ci": "tsc -p tsconfig.build.json && api-extractor run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist temp .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}

{
  "name": "studio",
  "version": "0.0.0",
  "private": true,
  "description": "tuicraft studio — Vite SPA, deploys to Vercel.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "echo 'no studio tests yet — see packages/core'",
    "clean": "rm -rf dist .turbo .vite *.tsbuildinfo"
  },
  "dependencies": {
    "@tuicraft/core": "workspace:*",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
